ServerAliveInterval=10

Host *
   Include config.d/*

Host 192.168.*.*
   StrictHostKeyChecking no
   UserKnownHostsFile=/dev/null

Host 127.0.*.*
   StrictHostKeyChecking no
   UserKnownHostsFile=/dev/null

Host gerrit.wikimedia.org
   RequiredRSASize=1024

Host github.com
   HostName ssh.github.com
   Port=443

Host *.wikimedia.cloud
   ProxyJump bastion.wmcloud.org:22

Host *.local
   ForwardAgent yes
